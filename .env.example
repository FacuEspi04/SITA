# Copiá este archivo como .env y completá los valores. El .env NUNCA se sube a GitHub (está en .gitignore).
# En Render (o cualquier hosting) estas mismas variables se cargan en el panel de "Environment".

# --- Neo4j (AuraDB con el grafo PG2) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=

# --- LLM (Groq por defecto; openai = cualquier API compatible con OpenAI) ---
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_TIMEOUT=600
LLM_PAUSA=0

# --- Opcionales ---
# SITA_IDS_EN_CUERPO=0
# SITA_LOG=logs/interacciones_pg3.jsonl
# Solo en el servidor: dominios del frontend que pueden llamar a la API, separados por coma
# SITA_CORS_ORIGINS=https://tu-proyecto.vercel.app
